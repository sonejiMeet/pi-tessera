{
	"name": "pi-tessera",
	"version": "1.3.0",
	"description": "Mosaic panel styling for Pi tool output: theme-aware syntax-highlighted diffs, collapsible sections, word-level change tinting and mouse hover/click.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"pi-coding-agent",
		"diff",
		"tui",
		"syntax-highlighting",
		"tool-renderer"
	],
	"license": "MIT",
	"author": "Meet Soneji",
	"type": "module",
	"files": [
		"extensions",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./extensions/tessera.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^1.4.0",
		"@earendil-works/pi-tui": "^1.4.0",
		"@types/node": "^22.19.0",
		"jiti": "^2.7.0",
		"typescript": "~5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.json",
		"test": "node test/smoke.mjs",
		"check": "tsc -p tsconfig.json && node test/smoke.mjs",
		"pack:check": "npm pack --dry-run"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sonejiMeet/pi-tessera.git"
	},
	"homepage": "https://github.com/sonejiMeet/pi-tessera#readme",
	"bugs": {
		"url": "https://github.com/sonejiMeet/pi-tessera/issues"
	},
	"publishConfig": {
		"access": "public"
	}
}
